# SYNTHETIC SOURCE MODE (DRUKSMART_SOURCE_MODE=synthetic).
# Points the REAL connectors at the synthetic-erp service, which serves the FICTIONAL fixture data
# in tests/fixtures/synthetic/. These keys are fixed test values of that service, NOT secrets.
# In this mode the pipeline writes to the isolated <analytics db>_test database (see run_step.sh).
ODOO_INSTANCE_ID=odoo-dtg-retail
ODOO_BASE_URL=http://synthetic-erp:8901
ODOO_DATABASE=
ODOO_API_KEY=test-odoo-key
ERPNEXT_INSTANCE_ID=erpnext-dtg-services
ERPNEXT_BASE_URL=http://synthetic-erp:8902
ERPNEXT_API_KEY=test-erp-key
ERPNEXT_API_SECRET=test-erp-secret
ERPNEXT_TIMEZONE=Asia/Thimphu
