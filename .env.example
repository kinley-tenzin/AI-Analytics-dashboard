# DrukSmart Analytics & AI Dashboard Platform - local development settings
#
# Copy to .env and replace every CHANGE_ME, or generate .env automatically:
#     python infrastructure/scripts/create_local_env.py
# .env is git-ignored. Never commit real passwords.

# Docker Compose project name (prefixes container and volume names)
COMPOSE_PROJECT_NAME=druksmart

# --- PostgreSQL server -------------------------------------------------------
# Host port for the PostgreSQL container. 5433 avoids clashing with a native
# PostgreSQL install that already uses the default 5432.
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 first and
# waits ~5 s per connection before falling back (measured in Milestone 1).
DRUKSMART_PG_HOST=127.0.0.1
DRUKSMART_PG_PORT=5433

# Bootstrap superuser. Used only by the container to initialise the server;
# application code must never connect with this account.
POSTGRES_USER=druksmart_admin
POSTGRES_PASSWORD=CHANGE_ME

# --- Databases ---------------------------------------------------------------
DRUKSMART_ANALYTICS_DB=druksmart_analytics
DRUKSMART_APP_DB=druksmart_app

# --- Service roles (least privilege) ----------------------------------------
# Ingestion + dbt: owns the raw/staging/intermediate/marts schemas.
DRUKSMART_PIPELINE_USER=druksmart_pipeline
DRUKSMART_PIPELINE_PASSWORD=CHANGE_ME

# Superset + AI KPI functions: read-only access to the marts schema only.
DRUKSMART_BI_READER_USER=druksmart_bi_reader
DRUKSMART_BI_READER_PASSWORD=CHANGE_ME

# Django application metadata (users, roles, settings) in DRUKSMART_APP_DB.
DRUKSMART_APP_USER=druksmart_app_user
DRUKSMART_APP_PASSWORD=CHANGE_ME

# --- ERP sources (read-only connectors) -----------------------------------------
# Instance ids are stable labels stored on every raw record; never reuse one for a
# different ERP installation. Use https for any non-local server.
# API keys belong to a dedicated READ-ONLY ERP user (see docs/connectors/CONNECTORS.md).
# For the local sandboxes they are filled in by the sandbox seed scripts.
ODOO_INSTANCE_ID=odoo-sandbox
ODOO_BASE_URL=http://127.0.0.1:8069
ODOO_DATABASE=druksmart_sandbox
ODOO_API_KEY=

ERPNEXT_INSTANCE_ID=erpnext-sandbox
ERPNEXT_BASE_URL=http://127.0.0.1:8090
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Time zone configured in the ERPNext site's System Settings (naive datetimes use it).
ERPNEXT_TIMEZONE=Asia/Thimphu

# Optional tuning
DRUKSMART_HTTP_TIMEOUT_SECONDS=30
DRUKSMART_PAGE_SIZE=200

# Superset's warehouse login: SELECT only on the approved datasets (superset/approved_datasets.yml).
DRUKSMART_SUPERSET_READER_USER=druksmart_superset_reader
DRUKSMART_SUPERSET_READER_PASSWORD=CHANGE_ME

# Django KPI service's warehouse login: SELECT only on backend/approved_datasets.yml.
DRUKSMART_KPI_READER_USER=druksmart_kpi_reader
DRUKSMART_KPI_READER_PASSWORD=CHANGE_ME

# --- Superset (docker compose --profile superset) ------------------------------------
# UI at http://127.0.0.1:${SUPERSET_PORT}; log in with SUPERSET_ADMIN_USER / SUPERSET_ADMIN_PASSWORD.
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME
SUPERSET_SECRET_KEY=CHANGE_ME
SUPERSET_DB_PASSWORD=CHANGE_ME
# Password shared by the DEMO role users created by superset/bootstrap (local testing only).
SUPERSET_DEMO_USER_PASSWORD=CHANGE_ME
# --- Website embedding of Superset dashboards (Milestone 10) ---
# Signs the short-lived guest tokens for embedded dashboards. MUST be secret: Superset's built-in
# default is public, and anyone knowing the secret could forge tokens without row-level security.
SUPERSET_GUEST_TOKEN_SECRET=CHANGE_ME
# Superset account the Django backend uses ONLY to issue guest tokens and read dashboard metadata.
SUPERSET_PORTAL_SERVICE_USER=druksmart_portal_service
SUPERSET_PORTAL_SERVICE_PASSWORD=CHANGE_ME
# The website's origin: the only site allowed to frame Superset dashboards.
DRUKSMART_WEB_ORIGIN=http://127.0.0.1:8000

# --- Django backend + AI assistant (python backend/manage.py runserver) ------------------
# UI at http://127.0.0.1:8000/assistant/ ; metadata in DRUKSMART_APP_DB as DRUKSMART_APP_USER.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Password shared by the DEMO users created by `manage.py seed_demo_users` (local testing only).
BACKEND_DEMO_USER_PASSWORD=CHANGE_ME
# Question interpreter: "rules" (deterministic, NO LLM) or "gemini" (needs GEMINI_API_KEY).
DRUKSMART_AI_PROVIDER=rules
# Google AI Studio key (https://aistudio.google.com/apikey). Leave EMPTY to disable Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Airflow (docker compose --profile airflow) --------------------------------------
# UI at http://127.0.0.1:${AIRFLOW_PORT}; log in with AIRFLOW_ADMIN_USER / AIRFLOW_ADMIN_PASSWORD.
AIRFLOW_PORT=8085
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_JWT_SECRET=CHANGE_ME
# Must be a Fernet key (create_local_env.py generates one).
AIRFLOW_FERNET_KEY=CHANGE_ME
# configured = ERPs from the ODOO_*/ERPNEXT_* settings (real ERPs or local sandboxes)
# synthetic  = fictional fixture data via the synthetic-erp service, written to <db>_test
DRUKSMART_SOURCE_MODE=configured
# Cron schedule (Asia/Thimphu) of the ELT DAG; "none" = manual runs only.
DRUKSMART_ELT_SCHEDULE=0 2 * * *

# --- Local ERP sandboxes (development only; synthetic data) -----------------------
ODOO_SANDBOX_DB_PASSWORD=CHANGE_ME
ODOO_SANDBOX_ADMIN_PASSWORD=CHANGE_ME
ERPNEXT_SANDBOX_DB_ROOT_PASSWORD=CHANGE_ME
ERPNEXT_SANDBOX_ADMIN_PASSWORD=CHANGE_ME
